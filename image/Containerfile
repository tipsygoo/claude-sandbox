FROM docker.io/library/ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive

# Base tools
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git ripgrep jq less python3 python3-venv \
 && rm -rf /var/lib/apt/lists/*

# Claude Code, from Anthropic's signed apt repository
RUN install -d -m 0755 /etc/apt/keyrings \
 && curl -fsSL https://downloads.claude.ai/keys/claude-code.asc \
      -o /etc/apt/keyrings/claude-code.asc \
 && echo "deb [signed-by=/etc/apt/keyrings/claude-code.asc] https://downloads.claude.ai/claude-code/apt/stable stable main" \
      > /etc/apt/sources.list.d/claude-code.list \
 && apt-get update \
 && apt-get install -y claude-code \
 && rm -rf /var/lib/apt/lists/*

# Non-root user with a fixed UID
RUN (userdel -r ubuntu 2>/dev/null || true) \
 && useradd -m -u 1000 -s /bin/bash claude \
 && mkdir -p /home/claude/.claude /workspace \
 && chown claude:claude /home/claude/.claude

# Managed settings: a root-owned policy file the claude user cannot change.
# On Linux, Claude Code reads it from /etc/claude-code/managed-settings.json
COPY managed-settings.json /etc/claude-code/managed-settings.json

ENV CLAUDE_CONFIG_DIR=/home/claude/.claude \
    DISABLE_AUTOUPDATER=1

USER claude
WORKDIR /workspace
CMD ["bash"]